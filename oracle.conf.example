# oracle.conf - settings shared by every script, read before each script's own <name>.conf.
# Copy to oracle.conf at the top of the tree (next to lib/) or to ~/.oracle.conf. chmod 600 if it holds passwords.

# The servers have no internet: no probes of download.oracle.com, no My Oracle Support; patch files are
# copied in by hand (README "Servers without internet access"). Without this each script probes once (5 s).
OFFLINE=1
# A proxy that does allow Oracle downloads (leave OFFLINE unset or 0 then)
#HTTPS_PROXY=http://proxy.example.com:3128

# SQL access when OS authentication (/ as sysdba) is not possible
#SQL_CMD="sqlplus -S"                    # or "sql -S" for SQLcl
#SQL_CONNECT="sys/password@//dbhost:1521/pdb1 as sysdba"

# ORDS / WebLogic URLs the verify steps check
#ORDS_URL=https://apex.example.com/ords/
#WLS_ADMIN_URL=t3://localhost:7001

# My Oracle Support (only latest/download, on a machine that can reach it). Since 2026 it takes a bearer token, not
# the password: log in to MOS in a browser, open https://updates.oracle.com/Orion/GenToken/get_token, Generate token
# (lasts 60 minutes), save it in ~/.mos-token (chmod 600) or point MOS_TOKEN_FILE at the file
#MOS_TOKEN_FILE=/home/oracle/.mos-token

# Where run logs go (default ~/<script>/runs)
#RUN_BASE=/u01/backup/scripts/runs

# One folder for everything downloaded: patch-manifest's manifest, the patch zips (<PATCH_BASE>/<kind> the
# tools' download commands use) and the get.sh/get.ps1 tools tree (<PATCH_BASE>/scripts). Default /u01/patches
# on a server. get-patches.ps1 (Windows) defaults to .\patches.
#PATCH_BASE=/u01/patches
