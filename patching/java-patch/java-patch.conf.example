# java-patch.conf - copy next to the script (or ~/.java-patch.conf). All optional; the shared ../oracle.conf is read too.

# The JDK to replace (default: the one WebLogic / ORDS use, when there is exactly one) and where new JDKs are unpacked
#JAVA_HOME=/u01/app/oracle/jdk              # best when this is a symlink to jdk1.8.0_xxx: the switch is then a link flip
#JAVA_BASE=/u01/app/oracle                  # default: the parent directory of the real JDK

# My Oracle Support for latest/download: a bearer token (60 minutes) from https://updates.oracle.com/Orion/GenToken/get_token,
# kept in ~/.mos-token (chmod 600) or the file named here; MOS_USER/MOS_PASSWORD no longer work
#MOS_TOKEN_FILE=/home/oracle/.mos-token

# Password of the JDK trust store when it is not the default
#CACERTS_PASSWORD=changeit

# What to restart so JVMs pick up the new JDK ('restart' command / --restart). name=command, comma separated.
# Without this an ORDS systemd unit is restarted when present; WebLogic is left for you.
#RESTART_CMDS="ords=sudo -n systemctl restart ords,wls=/u01/app/oracle/scripts/restart_domain.sh"

# URLs that must answer after the restart (verify), plus ORDS_URL if ORDS runs here
#CHECK_URLS=http://localhost:7001/console/,https://localhost:8443/ords/
#ORDS_URL=http://localhost:8080/ords/

# More files that name the JDK path and must be edited when it is not a symlink
#EXTRA_REF_FILES=/etc/sysconfig/myapp,/u01/app/oracle/scripts/env.sh

#RUN_BASE=/u01/backup/java-patch/runs
