# apex-export.conf - copy next to the script and chmod 600 (it holds the connect string). The shared ../oracle.conf is read too.

# How to connect for the export: user/password@//host:port/service. The user needs APEX_ADMINISTRATOR_ROLE to see
# every workspace (grant it to a dedicated schema: grant apex_administrator_role to apexexp), or use the workspace's
# parsing schema to export that workspace only. Passwords go to SQLcl on stdin, never on the command line.
APEX_EXPORT_CONNECT="apexexp/change_me@//dbhost:1521/pdb1"
# More databases/PDBs: one line each, used with --pdb NAME or --all (the name is only a label)
#APEX_EXPORT_CONNECT_PDB2="apexexp/change_me@//dbhost:1521/pdb2"
#APEX_EXPORT_CONNECT_TEST="apexexp/change_me@//testhost:1521/apextest"

# The git repository that receives the exports (created on the first export) and its remote for --push
#APEX_REPO=/u01/backup/apex-export/repo
#APEX_REMOTE=git@github.com:org/apex-exports.git
#APEX_PUSH=0                   # 1: "run" pushes after every commit
#GIT_AUTHOR_NAME=apex-export
#GIT_AUTHOR_EMAIL=apex-export@dbhost

# SQLcl (preferred: "apex export" built in). Without it the APEXExport java class is used (needs APEX_HOME, JAVA_HOME,
# OJDBC_JAR) and the password is visible in the process list while an export runs.
#SQLCL=/opt/oracle/sqlcl/bin/sql
#APEX_HOME=/opt/oracle/apex
#JAVA_HOME=/usr/lib/jvm/java-17
#OJDBC_JAR=/u01/app/oracle/product/19/dbhome_1/jdbc/lib/ojdbc8.jar
#EXPORT_TIMEOUT=1800

# Export options (apex export / APEXExport flags). -split one file per component, -skipExportDate stable diffs,
# -expOriginalIds keeps component ids so a restore does not renumber everything
#APEX_EXPORT_OPTS="-split -skipExportDate -expOriginalIds -expPubReports -expACLAssignments"

# Nightly run (install-cron), reports and run dirs, days before "verify" calls the export stale
#APEX_CRON="30 2 * * *"
#APEX_OUT=/u01/backup/apex-export
#RUN_BASE=/u01/backup/apex-export/runs
#APEX_STALE_DAYS=7
